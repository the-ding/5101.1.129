interrupt void Can1Rx_Handle(void)
{
    UINT8 com_flag = 1;
    //扩展帧 //
    //CAN1ToCAN0();
    if (CAN1RXIDR1 & 0x08)
    {
       com_flag =  GT_R1 (getEid (&CAN1RXIDR0));
    }
    if(com_flag == 1) {
        
        CanbusFrame *cf = &CAN1_RxBuf[CAN1_RxWPtr];
        //CAN4ToCAN0();
        if (!(CAN1RXIDR1 & 0x08))//标准帧
        {
            cf->id = (CAN1RXIDR0 << 3) | (CAN1RXIDR1 >> 5);
        }
        else //扩展帧
        {
            cf->id = getEid (&CAN1RXIDR0);
        }
        cf->pri     = 0;
        cf->len     = CAN1RXDLR & 0xF;
        cf->data[0] = CAN1RXDSR0;
        cf->data[1] = CAN1RXDSR1;
        cf->data[2] = CAN1RXDSR2;
        cf->data[3] = CAN1RXDSR3;
        cf->data[4] = CAN1RXDSR4;
        cf->data[5] = CAN1RXDSR5;
        cf->data[6] = CAN1RXDSR6;
        cf->data[7] = CAN1RXDSR7;

        //存入CAN4接收缓冲区，待协议模块处理或被丢弃//
        CAN1_RxWPtr = (CAN1_RxWPtr + 1) & (CAN1_RXBSZ - 1);
    }
    CAN1RFLG = 0x01; 
}

/*****************************************************************************/
/* SPI控制器收发函数                                                         */
/*****************************************************************************/
UINT8 SPI2_Send_Receve (UINT8 data)
{
    UINT8 temp;
    while (!SPI2SR_SPTEF);
    SPI2DR = data;

    while (!SPI2SR_SPIF);
    temp = SPI2DR;
    return temp;
}

/*****************************************************************************/
/* 读整车总电流                                                              */
/*****************************************************************************/
UINT16 ads1146_ad (void)
{
    UINT8 x,y,jj;

    PTP_PTP6 = 0;
    for(jj=0;jj<50;jj++)
      _FEED_COP(); /* feeds the dog */    //busclk:32MHz--.18s

    (void) SPI2_Send_Receve(0x12);

    for (jj = 0; jj < 50; jj++)
      _FEED_COP(); /* feeds the dog */    //busclk:32MHz--.18s

    x = SPI2_Send_Receve (0x55);
    y = SPI2_Send_Receve (0x55);
    PTP_PTP6 = 1;

    return ((UINT16)x << 8) | y;

}

static UINT8    DsIdx = 0;
static SINT16   Array[5] = {0,0,0,0,0};
static SINT16   TmpBuf[5];

/*****************************************************************************/
/* 10ms软件中断服务程序                                                      */
/*****************************************************************************/
interrupt void SoftwareTrigger0_Handler(void)
{
    UINT8   i;
    UINT32  DIVVV= 0;//存储累计个数
    UINT32  ams_2000_pos = 0;//存储累计个数
    SINT16  cur;

    Array[DsIdx] = (SINT16)ads1146_ad();
    DsIdx = (DsIdx == 4) ? 0 : (UINT8)(DsIdx + 1);

    for (i = 0; i < 5; i++)
        TmpBuf[i] = Array[i];

#define CHECK_SWAP(a,b) if (TmpBuf[a] < TmpBuf[b]) {SINT16 t = TmpBuf[a]; TmpBuf[a] = TmpBuf[b]; TmpBuf[b] = t; }

    for (i = 1; i < 5; i++) CHECK_SWAP (i, 0)
    for (i = 2; i < 5; i++) CHECK_SWAP (i, 1)
    for (i = 3; i < 5; i++) CHECK_SWAP (i, 2)

    //cur = (SINT16)((SINT32)TmpBuf[2] * OEM_Para.hallpara / 10000);  //单位为0.1A
    
    cur = TmpBuf[2] / 10;             // TmpBuf是经过电阻和放大倍数处理后的电压值,其值等同电流值
//       cur = 1000;
    Sys_Shared.C0_Raw = cur;                             // ADC计算的电流值
    
    cur -= OEM_Para.c0;                       // 去零漂

    Sys_Shared.CurrentRaw = cur;                         // 去零漂后的电流值
    
    cur = (SINT16)((SINT32)cur * OEM_Para.Ref / OEM_Para.Raw * OEM_Para.hallpara / 1000);
    if((cur<10)&&(cur>-10)) cur = 0; 
//    cur = 1000;
//////////////////////////////////////////////////////////////////////////////
//        OEM_Para.cur_dir;        //0x00 正电流soc减少   0x01 正电流soc增加 \\0x80   调换霍尔方向 \\0x00  正电流放电报警  ，

//////////////////////////////////////////////////////////////////////////////    
  if(OEM_Para.cur_dir&0x80) //调换霍尔方向
   
     cur = -cur;

  asm LOOP1: SSEM #0
  asm BCC LOOP1
 
  if(OEM_Para.cur_dir&0x01)
  {
       //放电为负   电流〈0  soc下烬    
       Sys_Rt.ams_2000 += cur;     // soc下降
  } 
  else
  {
       //放电为正   电流>0  soc下降  
      Sys_Rt.ams_2000 -= cur;     // soc下降
  }
  if(Sys_Rt.ams_2000 >= 2000 ) //2000 *10 /25 Sys_Rt.Ams 按照0.0006的soc计算分辨率（满足0.06的soc）最小分辨单位为2180ams
   {
      
      DIVVV  =  Sys_Rt.ams_2000 / 2000;//Sys_Rt.Ams 按照0.0006的soc计算分辨率（满足0.06的soc）最小分辨单位为2180ams
      Sys_Rt.TKAms +=  DIVVV  ;
      Sys_Rt.ams_2000 -= DIVVV*2000;
      
   }
   if(Sys_Rt.ams_2000 <= -2000) //Sys_Rt.Ams 按照0.0006的soc计算分辨率（满足0.06的soc）最小分辨单位为2180ams
   {
      
      ams_2000_pos = 0 -Sys_Rt.ams_2000; 
      DIVVV  =  ams_2000_pos / 2000;//Sys_Rt.Ams 按照0.0006的soc计算分辨率（满足0.06的soc）最小分辨单位为2180ams
      Sys_Rt.TKAms -=  DIVVV  ;
      Sys_Rt.ams_2000 += DIVVV*2000;
      
   }   
  
//////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////       
asm CSEM #0   

    Sys_Shared.cur  = cur;                    //单位为0.1A

    XGSWT = 0x0100;
    
    
     
}

/*****************************************************************************/
/* 21ms定时器中断服务程序                                                    */
/*****************************************************************************/
interrupt void PIT_Handler(void)
{


    PITTF = 8;
    /* 发送FIFO满 */
    CAN4TFLG = 1;
    //if (CAN4TFLG == 0x0)
    //    return;





#if PTL_QDWX
    //if (LECU_IdCur == 1)  // 与GT模式共存时
    //{
    //    WX_Ask_LECU ();
    //
    //    QDWX_IdCur++;
    //    if (QDWX_IdCur > Sys_Para.lecu_num)
    //        QDWX_IdCur = 1;
    //}



    #if PTL_HAVE_ISO
    if (Sys_Shared.iso_req)
    {
        Sys_Shared.iso_req = FALSE;
       WX_Ask_ISO ();
        
      
        return;
    }
#endif
  
  
    if (QDWX_IdCur <= Sys_Para.lecu_num)
        WX_Ask_LECU ();

    QDWX_IdCur++;
    if (QDWX_IdCur > 40)
        QDWX_IdCur = 1;
#endif

#if PTL_LECU                // 与QDWX模式共存时取消宏编译


    GT_Ask_LECU ();
    
    #if PTL_HAVE_ISO
    if (Sys_Shared.iso_req)
    {
        Sys_Shared.iso_req = FALSE;       
       
       GT_Ask_ISO();
      
        return;
    }
#endif
    
    
#endif

    LECU_IdCur++;
    if (LECU_IdCur > Sys_Para.lecu_num)
    {
        LECU_IdCur = 1;
        Sys_Shared.ask++;
    }
}


/*****************************************************************************/
/* 保护流程300ms中断                                                         */
/*****************************************************************************/
interrupt void  PROTECT_Handler(void)
{
    
     PITTF_PTF2 = 1;     //清中断
     Prot_Timer++;
   
}

// interrupt handler for all others
interrupt void ErrorHandler(int dataptr)
{
  int chanNum = dataptr;
  asm BRK;
}

