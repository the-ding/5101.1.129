/*****************************************************************************/
/* 获取CAN扩展帧ID                                                           */
/*****************************************************************************/
static UINT32 getEid (Byte *idr)
{
    UINT32 i=0;

    i = idr[0];           // CAN.RXIDR0;
    i <<= 3;
    i |= idr[1] >> 5;     // CAN.RXIDR1
    i <<= 3;
    i |= idr[1] & 0x07;   // CAN.RXIDR1
    i <<= 8;
    i |= idr[2];          // CAN.RXIDR2
    i <<= 7;
    i |= idr[3] >> 1;     // CAN.RXIDR3

    return i;
}

/*****************************************************************************/
/* 读出CAN帧数据域，直接存入目标结构体                                       */
/*****************************************************************************/
static void msgcpy1 (void *to)
{
    *((UINT16 *)to + 0) = *(UINT16 *)&CAN1RXDSR0;
    *((UINT16 *)to + 1) = *(UINT16 *)&CAN1RXDSR2;
    *((UINT16 *)to + 2) = *(UINT16 *)&CAN1RXDSR4;
    *((UINT16 *)to + 3) = *(UINT16 *)&CAN1RXDSR6;
}
static void msgcpy (void *to)
{
    *((UINT16 *)to + 0) = *(UINT16 *)&CAN4RXDSR0;
    *((UINT16 *)to + 1) = *(UINT16 *)&CAN4RXDSR2;
    *((UINT16 *)to + 2) = *(UINT16 *)&CAN4RXDSR4;
    *((UINT16 *)to + 3) = *(UINT16 *)&CAN4RXDSR6;
}

/*****************************************************************************/
/* 请求绝缘模块上送绝缘信息                                                  */
/*****************************************************************************/
static void GT_Ask_ISO (void)
{
    UINT8   tbsel;

    CAN4TBSEL = CAN4TFLG;
    tbsel = CAN4TBSEL;

#define GT_ASKRT_ID 0x100f6

    CAN4TXIDR0 = (UINT8)(GT_ASKRT_ID >> 21);
    CAN4TXIDR1 = (UINT8)(((GT_ASKRT_ID >> 18) & 0x07) << 5) | ((GT_ASKRT_ID >> 15) & 0x07) | 0x18;
    CAN4TXIDR2 = (UINT8)((GT_ASKRT_ID >> 7) & 0xff);
    CAN4TXIDR3 = (UINT8)((GT_ASKRT_ID << 1) & 0xff);

    CAN4TXDSR0 = 0x10;
    CAN4TXDSR1 = 8;
    CAN4TXDSR2 = 0;
    CAN4TXDSR3 = 0;
    CAN4TXDSR4 = 0;
    CAN4TXDSR5 = 0;
    CAN4TXDSR7 = 32;    // 绝缘模块ID

    CAN4TXDLR  = 8;
    CAN4TXTBPR = 0;
    CAN4TFLG   = tbsel;
}


/*****************************************************************************/
/* 请求绝缘模块上送绝缘信息                                                  */
/*****************************************************************************/
static void WX_Ask_ISO (void)
{
    UINT8   tbsel;

    CAN4TBSEL = CAN4TFLG;
    tbsel = CAN4TBSEL;

#define WX_ASKRT_ID 0x100

    CAN4TXIDR0 = (UINT8)( WX_ASKRT_ID >> 3 );
    CAN4TXIDR1 = (UINT8)( (WX_ASKRT_ID & 0x00ff) << 5 );

    CAN4TXDSR0 = 0x10;
    CAN4TXDSR1 = 32;
    CAN4TXDSR2 = 32;
    CAN4TXDSR3 = 0;
    CAN4TXDSR4 = 0;
    CAN4TXDSR5 = 0;
    CAN4TXDSR7 = 32;    // 绝缘模块ID

    CAN4TXDLR  = 8;
    CAN4TXTBPR = 0;
    CAN4TFLG   = tbsel;
}





void CAN0_Xgate_Write (CanbusFrame *cf)
{
    UINT8   tbsel;

    CAN0TBSEL = CAN0TFLG;
    tbsel = CAN0TBSEL;

    CAN0TXIDR0 = (UINT8)(cf->id >> 21);
    CAN0TXIDR1 = (UINT8)(((cf->id >> 18) & 0x07) << 5) | ((cf->id >> 15) & 0x07) | 0x18;
    CAN0TXIDR2 = (UINT8)(cf->id >> 7);
    CAN0TXIDR3 = (UINT8)(cf->id << 1);

    CAN0TXDSR0 = cf->data[0];
    CAN0TXDSR1 = cf->data[1];
    CAN0TXDSR2 = cf->data[2];
    CAN0TXDSR3 = cf->data[3];
    CAN0TXDSR4 = cf->data[4];
    CAN0TXDSR5 = cf->data[5];
    CAN0TXDSR6 = cf->data[6];
    CAN0TXDSR7 = cf->data[7];

    CAN0TXDLR  = cf->len;
    CAN0TXTBPR = cf->pri;

    CAN0TFLG   = tbsel;
    while (CAN0TFLG != 0x7);
}









static void GT_Ask_LECU (void)
{
    UINT8   tbsel;
    UINT32  bs = LECU_Rt[LECU_IdCur - 1].balsts;
    UINT8   bs2 = LECU_Rt[LECU_IdCur - 1].balsts2;

    CAN4TBSEL = CAN4TFLG;
    tbsel = CAN4TBSEL;

    CAN4TXIDR0 = (UINT8)(GT_ASKRT_ID >> 21);
    CAN4TXIDR1 = (UINT8)(((GT_ASKRT_ID >> 18) & 0x07) << 5) | ((GT_ASKRT_ID >> 15) & 0x07) | 0x18;
    CAN4TXIDR2 = (UINT8)((GT_ASKRT_ID >> 7) & 0xff);
    CAN4TXIDR3 = (UINT8)((GT_ASKRT_ID << 1) & 0xff);

    CAN4TXDSR0 = LECU_Rt[LECU_IdCur - 1].cmd;
    CAN4TXDSR1 = bs2;
    CAN4TXDSR2 = bs & 0xff;
    CAN4TXDSR3 = (bs >> 8)  & 0xff;
    CAN4TXDSR4 = (bs >> 16) & 0xff;
    CAN4TXDSR5 = (bs >> 24) & 0xff;
    CAN4TXDSR6 = bs2;
    CAN4TXDSR7 = LECU_IdCur;

    CAN4TXDLR  = 8;
    CAN4TXTBPR = 0;
    CAN4TFLG   = tbsel;
}

/*****************************************************************************/
/* CAN4控制器接收中断服务程序 - 处理冠拓BMS内部协议                          */
/*****************************************************************************/
UINT8 GT_R1 (UINT32 id)
{
    
    UINT8  sa = (UINT8)((id>>8) & 0xff);
    UINT8  fs = (UINT8) id & 0xff;
    UINT8  ps = (UINT8)((id>>16) & 0xff);

    if ((sa == 0xb2)&&(ps==0xb1))      
    {
        if(fs<17) //16
        {
           msgcpy1 ((UINT8 *) &Temp_point[(fs-1)*8+fs*4]);
        } else if(fs == 17){
            BCU2_heart      = CAN1RXDSR0;
            BCU2_sys_sts    = CAN1RXDSR1;  
            Kin_BX[0]       = CAN1RXDSR3;
            //ttttwww[1]      = *(UINT16 *) &CAN1RXDSR4; //260616
        }
        return 0;  
    }
    return 1;
}
/*****************************************************************************/
/* CAN4控制器接收中断服务程序 - 处理冠拓BMS内部协议                          */
/*****************************************************************************/
static void GT_Rx (void)
{
    UINT8 i=0;
    UINT8 j=0;
    UINT8 num_add=0;
    
    UINT32 id = getEid (&CAN4RXIDR0);
    
    
    
   
    if (LECU_Work == 0)      // (0) 正常工作模式 
    {
        UINT8  typ = (UINT8) id & 0xff;

        id >>= 8;
        if (typ == 0xf4 && id >= 0x110 && id < 0x400)      // 实时数据
        {
            UINT16  tmp;
            UINT16  dev = (UINT16)(id - 0x110)/16;   //changed
            UINT16  idx, limit;
            DBDevRt *Me = &LECU_Rt[dev];

            if (dev >= DEV_MAX)
                return;
            LECU_Age[dev] = 0;

            switch (id & 0xf)
            {
            case 0x0: // 模块电池信息1  CAN0X110
                    // if ((CAN4RXDSR0 & 0x7f) > DEV_CELL_MAX)
                    //     break;

                    //msgcpy ((void *) &Me->bodys);     //wjm20231010
                     //Me->volt = (CAN4RXDSR2<<8) | CAN4RXDSR3;      //wjm20231101
                     //Me->bodys  =LECU_NVT[dev].Cell_num|0x80;
                     //Me->tmpnum =LECU_NVT[dev].T_num|0x80;
                     Me->soc  = CAN4RXDSR5;
                     Me->soh  +=1;                //用于采集状态 //wjm20231101
                     //CAN4RXDSR0;// (CAN4RXDSR6<<8) | CAN4RXDSR7;  
                    // Moddle_Dev = dev ;
                    if (Cell_Temp_Indexs[dev] == 0xffff)
                    {
                        idx = 0;
                        for (tmp = 0; tmp < DEV_MAX; tmp++)
                        {
                         //   UINT8 bodys = LECU_Rt[tmp].bodys & 0x7f;
                            UINT8 bodys = 36;         //wjm20231010
                            if (bodys != 0 && tmp != dev)
                                idx += bodys;
                        }

                        if ((idx + 36) <= SYS_CELL_MAX)
                            Cell_Temp_Indexs[dev] = (dev)*36;
                    }

                    break;

            case 0x1: // 模块电池信息2+温度信息  CAN0X111
                    //温度33~36
                    VTemp_Middle[dev*40 + 32] = CAN4RXDSR0;
                    VTemp_Middle[dev*40 + 33] = CAN4RXDSR1;
                    VTemp_Middle[dev*40 + 34] = CAN4RXDSR2;
                    VTemp_Middle[dev*40 + 35] = CAN4RXDSR3;
                    VTemp_Middle[dev*40 + 36] = CAN4RXDSR3;
                    VTemp_Middle[dev*40 + 37] = CAN4RXDSR3;
                    VTemp_Middle[dev*40 + 38] = CAN4RXDSR3;
                    VTemp_Middle[dev*40 + 39] = CAN4RXDSR3;
                    break;

            case 0x2: // 模块电池温度信息  CAN0X112
                    //温度17~24
                    VTemp_Middle[dev*40 + 16] = CAN4RXDSR0;
                    VTemp_Middle[dev*40 + 17] = CAN4RXDSR1;
                    VTemp_Middle[dev*40 + 18] = CAN4RXDSR2;
                    VTemp_Middle[dev*40 + 19] = CAN4RXDSR3;
                    VTemp_Middle[dev*40 + 20] = CAN4RXDSR4;
                    VTemp_Middle[dev*40 + 21] = CAN4RXDSR5;
                    VTemp_Middle[dev*40 + 22] = CAN4RXDSR6;
                    VTemp_Middle[dev*40 + 23] = CAN4RXDSR7;

                    break;

            case 0x3: // 模块电池温度信息  CAN0X113
                    //温度25~32
                    VTemp_Middle[dev*40 + 24] = CAN4RXDSR0;
                    VTemp_Middle[dev*40 + 25] = CAN4RXDSR1;
                    VTemp_Middle[dev*40 + 26] = CAN4RXDSR2;
                    VTemp_Middle[dev*40 + 27] = CAN4RXDSR3;
                    VTemp_Middle[dev*40 + 28] = CAN4RXDSR4;
                    VTemp_Middle[dev*40 + 29] = CAN4RXDSR5;
                    VTemp_Middle[dev*40 + 30] = CAN4RXDSR6;
                    VTemp_Middle[dev*40 + 31] = CAN4RXDSR7;

                    break;

            case 0x4: // LECU版本号和编号信息  CAN0X114
                    msgcpy ((void *) &Me->swver);
                    break;

            case 0x5: // 模块温度采样点信息  CAN0X115
                
                   //温度1~8
                   VTemp_Middle[dev*40 + 0] = CAN4RXDSR0;
                   VTemp_Middle[dev*40 + 1] = CAN4RXDSR1;
                   VTemp_Middle[dev*40 + 2] = CAN4RXDSR2;
                   VTemp_Middle[dev*40 + 3] = CAN4RXDSR3;
                   VTemp_Middle[dev*40 + 4] = CAN4RXDSR4;
                   VTemp_Middle[dev*40 + 5] = CAN4RXDSR5;
                   VTemp_Middle[dev*40 + 6] = CAN4RXDSR6;
                   VTemp_Middle[dev*40 + 7] = CAN4RXDSR7;
                   break;

            case 0x6: // 模块温度采样点信息  CAN0X116
                    
                    //温度9~16
                    VTemp_Middle[dev*40 + 8] = CAN4RXDSR0;
                    VTemp_Middle[dev*40 + 9] = CAN4RXDSR1;
                    VTemp_Middle[dev*40 + 10] = CAN4RXDSR2;
                    VTemp_Middle[dev*40 + 11] = CAN4RXDSR3;
                    VTemp_Middle[dev*40 + 12] = CAN4RXDSR4;
                    VTemp_Middle[dev*40 + 13] = CAN4RXDSR5;
                    VTemp_Middle[dev*40 + 14] = CAN4RXDSR6;
                    VTemp_Middle[dev*40 + 15] = CAN4RXDSR7;
                    break;

            case 0x7: // 模块单体电压信息 CAN0X117
            case 0x8:
            case 0x9:
            case 0xa:
            case 0xb:
            case 0xc:
            case 0xd:
            case 0xe:
            case 0xf:
                    idx = dev*36;
                    if (idx == 0xffff)
                        break;

                    //根据CAN帧ID低四位，计算电池电压数组下标
                   // limit = idx + (Me->bodys & 0x7f);
                    limit = idx + 36;

                    idx += ((UINT8)(id & 0xf) - 0x7) * 4;


                    //每CAN帧最多携带4只电池电压
                    for (tmp = 0; (tmp < 4) && (idx < limit); tmp++)
                    {
                        Cell_Temp_Volts[idx] = *((UINT16 *)&CAN4RXDSR0 + tmp);
                        idx++;
                        
                    }
                    break;
            }
       }
        
        if (id == 0x500)
        {
            Sys_Rt.relayPRE  = *(UINT16 *) &CAN4RXDSR0 ;
            Sys_Rt.total_vol_res  = *(UINT16 *) &CAN4RXDSR2 ;
              
            Sys_Rt.pos_res = *(UINT16 *) &CAN4RXDSR4 ;
           //// Sys_Rt.neg_res = *(UINT16 *) &CAN4RXDSR6;
            Sys_Shared.iso_age = 0;
        }
        else if (id == 0x501)
        {
          
                 
            Sys_Shared.iso_opv = *(UINT32 *) &CAN4RXDSR0;   
            Sys_Shared.iso_age = 0;
                
        }
        else if (id == 0x502)  //绝缘模块sn
        {
            ISO_message.iso_sn = *(UINT32 *) &CAN4RXDSR0;
            //ISO_message.iso_sn = 0x87654321;
        }
        else if (id == 0x503) //绝缘模块定制号,软件版本,硬件版本
        {
            ISO_message.iso_oem = *(UINT16 *) &CAN4RXDSR0;
            ISO_message.iso_core = CAN4RXDSR2;
            ISO_message.iso_swer = CAN4RXDSR3;
            ISO_message.iso_hwer = *(UINT16 *) &CAN4RXDSR4;
        }
        else if (id == 0x504)
        {
            Sys_Rt.relayFAST = *(UINT16 *) &CAN4RXDSR0;
            Sys_Rt.relaySLOW = *(UINT16 *) &CAN4RXDSR2;
            Sys_Rt.NCNC      = *(UINT16 *) &CAN4RXDSR4;
        }    
        else if ((id > 0x700)&&(id<0x720))
        {   
            UINT16  index_12;
               
            index_12 = (UINT16)(id - 0x701);
            // index_12 >>= 8;
            LECU_Rt[index_12].in_stauts  = *(UINT32 *) &CAN4RXDSR0;
            LECU_Rt[index_12].out_stauts  = *(UINT32 *) &CAN4RXDSR4;    
        } 
    
    }
    else
    
     if (LECU_Work == 3)  /* (3) 采集器下载程序模式，将CAN帧数据部分转发到485总线 */
    {
        unsigned i;

        SCI0CR2_TCIE = 0;
        for (i = 0; i < 8; i++)
        {
          UINT8 ch = *((UINT8 *)&CAN4RXDSR0 + i);

          if (!txBusy)
          {
              txBusy = TRUE;

              PTS_PTS4 = 1;                         /* 485收发器 - 发送 */
              SCI0DRL = ch;
          }
          else
          {
              txBuf[txWptr] = ch;
              txWptr = (txWptr + 1) & (BUFSZ - 1);
          }
        }
        SCI0CR2_TCIE = 1;
    }
    else if ((CAN4RXDLR & 0xF) >= 5 &&
        (id & 0x0FFFFFFF) == (*(UINT32 *)&CAN4RXDSR0 & 0x0FFFFFFF)) /* (1) 或 (2) 搜索采集板模式 */
    {
        UINT32  sn = *(UINT32 *)&CAN4RXDSR0;
        UINT8   i;

        /*首先查看SN是否已经存在*/
        for (i = 0; i < LECU_SnNum; i++)
        if (LECU_SnList[i] == sn)
          break;

        /*如果不存在，插入列表*/
        if (i == LECU_SnNum && i < DEV_MAX)
        {
            LECU_IdList[LECU_SnNum] = CAN4RXDSR4;
            LECU_SnList[LECU_SnNum] = sn;

            LECU_SnNum++;
        }
    }
}

/*****************************************************************************/
/* CAN4控制器接收中断服务程序 - 处理万向BMS内部协议                          */
/*****************************************************************************/
#if PTL_QDWX
static void WX_Ask_LECU (void)
{
    UINT8   tbsel;
    UINT32  bs = LECU_Rt[QDWX_IdCur - 1].balsts;

    CAN4TBSEL = CAN4TFLG;
    tbsel = CAN4TBSEL;

#define ASKRT_ID    0x100
    CAN4TXIDR0 = (UINT8)( ASKRT_ID >> 3 );
    CAN4TXIDR1 = (UINT8)( (ASKRT_ID & 0x00ff) << 5 );

    CAN4TXDSR0 = LECU_Rt[QDWX_IdCur - 1].cmd | 0x10;//1---- non-sleep;0---- sleep// to be continue....... 参见内网协议
    CAN4TXDSR1 = QDWX_IdCur;
    CAN4TXDSR2 = bs & 0xff;           //均衡控制
    CAN4TXDSR3 = (bs >> 8)  & 0xff;
    CAN4TXDSR4 = (bs >> 16) & 0xff;
    CAN4TXDSR5 = 0;//保留
    CAN4TXDSR6 = 0;
    CAN4TXDSR7 = 0;

    CAN4TXDLR  = 8;
    CAN4TXTBPR = 0;
    CAN4TFLG   = tbsel;
}

static void WX_Rx (void)
{
    CanbusFrame *cf = &CAN4_RxBuf[CAN4_RxWPtr];
    UINT16 id = (CAN4RXIDR0 << 3) | (CAN4RXIDR1 >> 5);

    if( id == 0x31 || id == 0x30 || id == 0x33)
    {
        cf->id = id;
        cf->pri = 0;
        cf->len = CAN4RXDLR & 0xF;

        cf->data[0] = CAN4RXDSR0;
        cf->data[1] = CAN4RXDSR1;
        cf->data[2] = CAN4RXDSR2;
        cf->data[3] = CAN4RXDSR3;
        cf->data[4] = CAN4RXDSR4;
        cf->data[5] = CAN4RXDSR5;
        cf->data[6] = CAN4RXDSR6;
        cf->data[7] = CAN4RXDSR7;

        /*存入CAN1接收缓冲区，待协议模块处理或被丢弃*/
        CAN4_RxWPtr = (CAN4_RxWPtr + 1) & (CAN4_RXBSZ - 1);
    }
    if (id >= 0x110 && id < 0x300)
    {
        UINT16  tmp;
        UINT16  dev = (UINT16)(id - 0x110)/16;
        UINT16  idx, limit;
        DBDevRt *Me = &LECU_Rt[dev];

        if (dev >= DEV_MAX)
            return;


        LECU_Valids |= 1UL << dev;
        LECU_Age[dev] = 0;
        lecutick[dev] = gSysTicks;

        switch (id & 0xf)
        {
        case 0x0: // 模块电池信息1  CAN0X110
                if ((CAN4RXDSR0 & 0x7f) > DEV_CELL_MAX)
                    break;

                msgcpy ((void *) &Me->bodys);

                if (Cell_Indexs[dev] == 0xffff)
                {
                    idx = 0;
                    for (tmp = 0; tmp < DEV_MAX; tmp++)
                    {
                        UINT8 bodys = LECU_Rt[tmp].bodys & 0x7f;

                        if (bodys != 0 && tmp != dev)
                            idx += bodys;
                    }

                    if (idx + (Me->bodys & 0x7f) <= SYS_CELL_MAX)
                        Cell_Indexs[dev] = idx;
                }
                break;

        case 0x1: // 模块电池信息2  CAN0X111
                msgcpy ((void *) &Me->itmp);
                break;

        case 0x2: // 模块电池电压信息  CAN0X112
                Me->maxv    = *(UINT16 *) &CAN4RXDSR0;
                Me->maxvnr  = CAN4RXDSR2;

                tmp  = CAN4RXDSR3<<8;
                tmp |= CAN4RXDSR4;
                Me->minv   = tmp;
                Me->minvnr = CAN4RXDSR5;

                Me->avv =  *(UINT16 *) &CAN4RXDSR6;
                break;

        case 0x3: // 模块电池温度信息  CAN0X113
                //msgcpy ((void *) &Me->maxtmp);
                {
                  UINT16 maxt=0,mint=0,avt=0;
                  UINT8  maxtnr=0,mintnr=0;

                  maxt    = *(UINT16 *) &CAN4RXDSR0;
                  maxtnr  = CAN4RXDSR2;
                  mint    = (CAN4RXDSR3<<8)|CAN4RXDSR4;
                  mintnr  = CAN4RXDSR5;
                  avt     = (CAN4RXDSR6<<8)|CAN4RXDSR7;

                  Me->maxtmp    = (UINT8)((maxt&0x7fff)/10);
                  Me->maxtmpnr  = maxtnr;
                  Me->mintmp    = (UINT8)((mint&0x7fff)/10);
                  Me->mintmpnr  = mintnr;
                  Me->avtmp     = (UINT8)((avt&0x7fff)/10);

                }
                break;

        case 0x4: // LECU版本号和编号信息  CAN0X114
                msgcpy ((void *) &Me->swver);
                break;

        case 0x5: // 模块温度采样点信息1  CAN0X115
                //msgcpy ((void *) &Me->tmps);
                Me->tmps[0] = (UINT8)(((*(UINT16 *)&CAN4RXDSR0) & 0x7fff) / 10);
                Me->tmps[1] = (UINT8)(((*(UINT16 *)&CAN4RXDSR2) & 0x7fff) / 10);
                Me->tmps[2] = (UINT8)(((*(UINT16 *)&CAN4RXDSR4) & 0x7fff) / 10);
                Me->tmps[3] = (UINT8)(((*(UINT16 *)&CAN4RXDSR6) & 0x7fff) / 10);

                break;

        case 0x6: // 模块温度采样点信息2  CAN0X116
                //msgcpy ((UINT8 *) &Me->tmps + 8);
                Me->tmps[4] = (UINT8)(((*(UINT16 *)&CAN4RXDSR0) & 0x7fff) / 10);
                Me->tmps[5] = (UINT8)(((*(UINT16 *)&CAN4RXDSR2) & 0x7fff) / 10);
                Me->tmps[6] = (UINT8)(((*(UINT16 *)&CAN4RXDSR4) & 0x7fff) / 10);
                Me->tmps[7] = (UINT8)(((*(UINT16 *)&CAN4RXDSR6) & 0x7fff) / 10);
                break;

        case 0x7: // 模块单体电压信息 CAN0X117
        case 0x8:
        case 0x9:
        case 0xa:
        case 0xb:
        case 0xc:
        case 0xd:
        case 0xe:
        case 0xf:
                idx = Cell_Indexs[dev];
                if (idx == 0xffff)
                    break;

                /*根据CAN帧ID低四位，计算电池电压数组下标*/
                limit = idx + (Me->bodys & 0x7f);
                idx += ((UINT16)(id & 0xf) - 0x7) * 4;

                /*每CAN帧最多携带4只电池电压*/
                for (tmp = 0; tmp < 4 && idx < limit; tmp++)
                {
                    Cell_Volts[idx] = *((UINT16 *)&CAN4RXDSR0 + tmp);
                    idx++;
                }
                //msgcpy ((UINT8 *) &Cell_Volts[idx] + tmp*8);
                break;
        }
    }
   if (id == 0x500)
    {
                  Sys_Rt.relayPRE  = *(UINT16 *) &CAN4RXDSR0 ;
                  Sys_Rt.total_vol_res  = *(UINT16 *) &CAN4RXDSR2 ;
              
                Sys_Rt.pos_res = *(UINT16 *) &CAN4RXDSR4 ;
                Sys_Rt.neg_res = *(UINT16 *) &CAN4RXDSR6 ;
                Sys_Shared.iso_age = 0;
                
    }
   else if (id == 0x501)
            {
               
                Sys_Shared.iso_opv = *(UINT32 *) &CAN4RXDSR0;
                Sys_Shared.iso_age = 0;
                
                
            }
            else if (id == 0x502)  //绝缘模块sn
        {
            ISO_message.iso_sn = *(UINT32 *) &CAN4RXDSR0;
        }
        else if (id == 0x503) //绝缘模块定制号,软件版本,硬件版本
        {
            ISO_message.iso_oem = *(UINT16 *) &CAN4RXDSR0;
            ISO_message.iso_core = CAN4RXDSR2;
            ISO_message.iso_swer = CAN4RXDSR3;
            ISO_message.iso_hwer = *(UINT16 *) &CAN4RXDSR4;
        }
   
    if((id>0x700)&&(id<0x720))////
     {
              UINT8 index_12 = 0;
               index_12 = (id - 0x701);
               LECU_Rt[index_12].in_stauts  = *(UINT32 *) &CAN4RXDSR0 ;
               LECU_Rt[index_12].out_stauts  =  *(UINT32 *) &CAN4RXDSR4 ;
               
     }
    
}
#endif

static void CAN4ToCAN0 (void)
{
    UINT8   tbsel;

    CAN0TBSEL = CAN0TFLG;       /* 将CAN4收到的所有报文，整个转发到CAN0 */
    tbsel = CAN0TBSEL;

    CAN0TXIDR0 = CAN4RXIDR0;
    CAN0TXIDR1 = CAN4RXIDR1;
    CAN0TXIDR2 = CAN4RXIDR2;
    CAN0TXIDR3 = CAN4RXIDR3;

    CAN0TXDSR0 = CAN4RXDSR0;
    CAN0TXDSR1 = CAN4RXDSR1;
    CAN0TXDSR2 = CAN4RXDSR2;
    CAN0TXDSR3 = CAN4RXDSR3;
    CAN0TXDSR4 = CAN4RXDSR4;
    CAN0TXDSR5 = CAN4RXDSR5;
    CAN0TXDSR6 = CAN4RXDSR6;
    CAN0TXDSR7 = CAN4RXDSR7;

    CAN0TXDLR  = CAN4RXDLR;
    CAN0TXTBPR = 0;
    CAN0TFLG   = tbsel;
}

static void CAN0ToCAN4 (void)
{
    UINT8   tbsel;

    CAN4TBSEL = CAN4TFLG;       /* 将CAN0收到的所有报文，整个转发到CAN4 */
    tbsel = CAN4TBSEL;

    CAN4TXIDR0 = CAN0RXIDR0;
    CAN4TXIDR1 = CAN0RXIDR1;
    CAN4TXIDR2 = CAN0RXIDR2;
    CAN4TXIDR3 = CAN0RXIDR3;

    CAN4TXDSR0 = CAN0RXDSR0;
    CAN4TXDSR1 = CAN0RXDSR1;
    CAN4TXDSR2 = CAN0RXDSR2;
    CAN4TXDSR3 = CAN0RXDSR3;
    CAN4TXDSR4 = CAN0RXDSR4;
    CAN4TXDSR5 = CAN0RXDSR5;
    CAN4TXDSR6 = CAN0RXDSR6;
    CAN4TXDSR7 = CAN0RXDSR7;

    CAN4TXDLR  = CAN0RXDLR;
    CAN4TXTBPR = 0;
    CAN4TFLG   = tbsel;
}
static void CAN1ToCAN0 (void)
{
    UINT8   tbsel;

    CAN0TBSEL = CAN0TFLG;       /* 将CAN4收到的所有报文，整个转发到CAN0 */
    tbsel = CAN0TBSEL;

    CAN0TXIDR0 = CAN1RXIDR0;
    CAN0TXIDR1 = CAN1RXIDR1;
    CAN0TXIDR2 = CAN1RXIDR2;
    CAN0TXIDR3 = CAN1RXIDR3;

    CAN0TXDSR0 = CAN1RXDSR0;
    CAN0TXDSR1 = CAN1RXDSR1;
    CAN0TXDSR2 = CAN1RXDSR2;
    CAN0TXDSR3 = CAN1RXDSR3;
    CAN0TXDSR4 = CAN1RXDSR4;
    CAN0TXDSR5 = CAN1RXDSR5;
    CAN0TXDSR6 = CAN1RXDSR6;
    CAN0TXDSR7 = CAN1RXDSR7;

    CAN0TXDLR  = CAN1RXDLR;
    CAN0TXTBPR = 0;
    CAN0TFLG   = tbsel;
}
/*****************************************************************************/
/* CAN4控制器接收中断服务程序                                                */
/*****************************************************************************/
interrupt void Can4Rx_Handle(void)
{
  //UINT32  index_12;
  //  CAN4ToCAN0 ();
    if (BCU_Update || BCU_Transport)
    {
        //CAN4ToCAN0 ();
    }
    else
    {
        //扩展帧 //
        if (CAN4RXIDR1 & 0x08)
        {
            GT_Rx ();
        }

        #if PTL_QDWX
        if (!(CAN4RXIDR1 & 0x08))   /* 标准帧 */
          WX_Rx ();  //
        #endif

        // 扩展帧//
        if (CAN4RXIDR1 & 0x08)
        {
            UINT32 id = getEid (&CAN4RXIDR0);

            if (((UINT8) id & 0xff) == 0xf6)      // 模块参数
            {
                UINT8 grp = (id >> 8) & 0xf;

                if (grp >= 1 && grp <= 6)
                {
                    TempDevGot |= 1 << (grp - 1);
                    msgcpy (&TempDevPara.coltd + (grp - 1)*8);
                }
            }
           
        }
        else
        {
            UINT16 id = (CAN4RXIDR0 << 3) | (CAN4RXIDR1 >> 5);

            if (id == 0x555 || id == 0x31 || id == 0x30)
            {
                CanbusFrame *cf = &CAN4_RxBuf[CAN4_RxWPtr];

                cf->id = id;
                cf->pri = 0;
                cf->len = CAN4RXDLR & 0xF;
                cf->data[0] = CAN4RXDSR0;
                cf->data[1] = CAN4RXDSR1;
                cf->data[2] = CAN4RXDSR2;
                cf->data[3] = CAN4RXDSR3;
                cf->data[4] = CAN4RXDSR4;
                cf->data[5] = CAN4RXDSR5;
                cf->data[6] = CAN4RXDSR6;
                cf->data[7] = CAN4RXDSR7;

                //存入CAN1接收缓冲区，待协议模块处理或被丢弃//
                CAN4_RxWPtr = (CAN4_RxWPtr + 1) & (CAN4_RXBSZ - 1);
            }
        }
    }

    //Release RxBuf//
    CAN4RFLG = 0x01;
}

/*****************************************************************************/
/* KWP2000协议处理，主要完成采集板软件升级功能                               */
/*****************************************************************************/
static BOOL KWP2000_Rx (void)
{
    BOOL    start = FALSE;
    UINT16  id = (CAN0RXIDR0 << 3) | (CAN0RXIDR1 >> 5);

    //特殊报文处理//
    if (id == 0x555 && CAN0RXDLR == 8)
    {
      if (CAN0RXDSR0 == 0xde && CAN0RXDSR1 == 0xad && CAN0RXDSR2 == 'H' && CAN0RXDSR3 == 'C' && CAN0RXDSR4 == '0'/* && CAN0RXDSR5 == '8'*/)
      {
          //开始给采集板下载软件//
          start = TRUE;
      }
      else
      {
          //终止给采集板下载软件//
          PITINTE_PINTE3 = 1;
          BCU_Update = FALSE;
          BCU_Transport = FALSE;

          return FALSE;
      }
    }
    else if (id == 0x789)
    {
        PITINTE_PINTE3 = 0;         //PIT中断关闭,停止采集板数据招测//
        BCU_Transport = TRUE;

        CAN0ToCAN4 ();

        //Release RxBuf//
        CAN0RFLG = 0x01;

        return TRUE;
    }

    if (BCU_Update || start)
    {
        PITINTE_PINTE3 = 0;         //PIT中断关闭,停止采集板数据招测///

        CAN0ToCAN4 ();

       //按KWP2000链路层协议，替采集板恢复应答报?//
        if (BCU_Update)
        {
          static UINT16 CanBytes;
          static BOOL   CanFF;
          static UINT8  MySN;
          static UINT16 CanPos;
          UINT8         CanSN;

          switch (CAN0RXDSR0 & 0xf0)
          {
          case 0x00:    // Single Frame (SF)
              break;

          case 0x10:    // First Frame (FF)
              CanBytes = ((CAN0RXDSR0 & 0xF) << 8) | CAN0RXDSR1;
              CanFF = TRUE;
              MySN = 0;
              CanPos = 6;

Ack:          CAN0TBSEL = 0x1;
              CAN0TXIDR0 = CAN0RXIDR0;
              CAN0TXIDR1 = CAN0RXIDR1;

              CAN0TXDSR0 = 0x30 | 0x0;//ContinueToSend//;
              CAN0TXDSR1 = MySN;
              CAN0TXDSR2 = 0xf5;//STmin//;
              CAN0TXDLR  = 3;
              CAN0TFLG = 0x1;
              break;

          case 0x20:    // Consecutive Frame (CF)
              if (!CanFF)
                break;

              CanSN = CAN0RXDSR0 & 0xF;
              if (CanSN != MySN)
              {
                  goto Ack;
              }

              MySN = (MySN + 1) & 0xF;

              CanPos += CAN0RXDLR - 1;
              if (CanPos >= CanBytes)
              {
                  CanFF = 0;
                  MySN = 0;
                  goto Ack;
              }
          }
        }

        //Release RxBuf//
        CAN0RFLG = 0x01;

        BCU_Update = TRUE;
        return TRUE;
    }
    
    
    return FALSE;
}
 
/*****************************************************************************/
/* CAN0控制器接受中断服务程序                                                */
/*****************************************************************************/
interrupt void Can0Rx_Handle(void)
{
    UINT8   np = (CAN0_RxWPtr + 1) & (CAN0_RXBSZ - 1);

    if (!(CAN0RXIDR1 & 0x08)&& KWP2000_Rx () )
      return;

    if (np != CAN0_RxRPtr)
    {
        CanbusFrame *cf = &CAN0_RxBuf[CAN0_RxWPtr];
    
        if (!(CAN0RXIDR1 & 0x08))
        {
            /* 标准帧 */
    
            cf->id = (CAN0RXIDR0 << 3) | (CAN0RXIDR1 >> 5);
        }
        else
        {
            /* 扩展帧 */
    
            cf->id = getEid (&CAN0RXIDR0);
        }
    
        cf->pri = 0;
        cf->len = CAN0RXDLR & 0xF;
        cf->data[0] = CAN0RXDSR0;
        cf->data[1] = CAN0RXDSR1;
        cf->data[2] = CAN0RXDSR2;
        cf->data[3] = CAN0RXDSR3;
        cf->data[4] = CAN0RXDSR4;
        cf->data[5] = CAN0RXDSR5;
        cf->data[6] = CAN0RXDSR6;
        cf->data[7] = CAN0RXDSR7;
    
        /*存入CAN0接收缓冲区，待协议模块处理或被丢弃*/
        CAN0_RxWPtr = np;
    }

    /*Release RxBuf*/
    CAN0RFLG = 0x01;
}
